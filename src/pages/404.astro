---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found - DataTech Consulting and Contracting"
  description="The page you were looking for is not on the DataTech website. See our fixed-scope offers, proof, and contact pages instead."
>
  <div class="wrap">
    <h1 class="page-title">Page not found</h1>
    <p class="lede">
      The page you were looking for is not here. It may have been part of our
      old website, which we replaced with a simpler one.
    </p>
    <section>
      <p>Try one of these instead:</p>
      <ul>
        <li><a href="/offers/">Fixed-scope offers, with prices</a></li>
        <li><a href="/offers/ai-support-assistant/">AI Support Assistant, our main offer</a></li>
        <li><a href="/proof/">Proof, from work we own</a></li>
        <li><a href="/about/">About DataTech</a></li>
        <li><a href="/contact/">Contact and fit calls</a></li>
      </ul>
      <p>
        If you followed a link from another site and expected something
        specific, email us at
        <a href="mailto:charlie@datatech.vip">charlie@datatech.vip</a> and tell
        us what you were looking for.
      </p>
    </section>
  </div>
</Base>
